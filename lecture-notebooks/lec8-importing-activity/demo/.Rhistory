prof_vec_print <- function(x) {
name <- "["
for (idx in 1:count(x)) {
if (idx < count(x)) {
name <- paste0(name, x[idx], ", ")
} else {
name <- paste0(name, x[idx], "]")
}
}
paste(typeof(x), name)
}
prof_vec_print <- function(x) {
name <- "["
for (idx in 1:count(x)) {
if (idx < count(x)) {
name <- paste0(name, x[idx], ", ")
} else {
name <- paste0(name, x[idx], "]")
}
}
paste(typeof(x), name)
}
prof_vec_print(c("A"))
prof_vec_print <- function(x) {
name <- "["
for (idx in 1:prof_count(x)) {
if (idx < prof_count(x)) {
name <- paste0(name, x[idx], ", ")
} else {
name <- paste0(name, x[idx], "]")
}
}
paste(typeof(x), name)
}
prof_vec_print(c("A"))
prof_count <- function(x) {
n <- 0L
for (value in x) {
n <- n + 1L
}
n
}
prof_vec_print(c("A"))
prof_vec_print <- function(x) {
name <- "["
for (idx in 1:prof_count(x)) {
if (idx < prof_count(x)) {
name <- paste0(name, x[idx], ", ")
} else {
name <- paste0(name, x[idx], "]")
}
}
paste(typeof(x), name)
}
prof_vec_print(c("A"))
prof_change <- function(money, cost){
if (money >= cost){
leftover <- as.integer((money - cost) * 100)
quarters <- leftover %/% 25L
leftover <- leftover %% 25L
dimes <- leftover %/% 10L
leftover <- leftover %% 10L
nickels <- leftover %/% 5L
pennies <- leftover %% 5L
c(quarters=quarters, dimes=dimes, nickels=nickels, pennies=pennies)
} else {
"Not enough money to cover the cost."
}
}
prof_change(5.00, 4.99)
as.integer((5.00 - 4.99) * 100)
as.integer((5.00*100L- 4.99*100L)
)
as.integer((5.00*100L- 4.99*100L))
